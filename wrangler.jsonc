{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrpass",
  "main": "worker-v13.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["30 6 * * 1-5"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
